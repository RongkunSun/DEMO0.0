# ===== layeredimage定义 =====
layeredimage qy:
    #zoom 0.25

    group body:
        attribute koalcoat default
        attribute koalcoatred
     
    group face:

        attribute normal default:
            "qy_face_normal"

        attribute displeasure:
            "qy_face_displeasure"

        attribute happy:
            "qy_face_happy"

        attribute confident:
            "qy_face_confident"
        attribute sad:
            "qy_face_sad"   
        attribute speaking:
            "qy_face_speaking"
        attribute unhappy:
